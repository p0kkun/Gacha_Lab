generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         Int       @id @default(autoincrement())
  userId                     String    @unique
  displayName                String?
  pictureUrl                 String?
  lastAccessedReferralLinkId String?
  lastAccessedReferralAt     DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([createdAt])
  @@map("users")
}

model GachaItem {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  usageType   ItemUsageType @default(IMAGE)
  isActive    Boolean       @default(true)
  useStartAt  DateTime?
  useEndAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  gachaHistories   GachaHistory[]
  prizeAssignments GachaPrizeAssignment[]
  userItems        UserItem[]
  usageLogs        ItemUsageLog[]

  @@index([isActive])
  @@index([useStartAt])
  @@index([useEndAt])
  @@map("gacha_items")
}

model GachaType {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  name         String
  description  String?
  iconImageUrl String?
  isActive     Boolean   @default(true)
  startAt      DateTime?
  endAt        DateTime?
  pointCost    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prizeWeights Json?
  prizeHands   Json?
  prizeOrder   Json?

  commonVideoAssetIds Int[]   @default([])
  tierVideoAssetIds   Json?
  useDefaultVideos    Boolean @default(true)

  resultMessageTemplateId Int?

  gachaHistories            GachaHistory[]
  prizeAssignments          GachaPrizeAssignment[]
  tierWeights               GachaTierWeight[]
  resultMessageTemplate     ResultMessageTemplate? @relation(fields: [resultMessageTemplateId], references: [id])
  referrerFreeGachaSettings FreeGachaSettings[]    @relation("ReferrerFreeGacha")
  refereeFreeGachaSettings  FreeGachaSettings[]    @relation("RefereeFreeGacha")

  @@index([isActive])
  @@index([isActive, startAt, endAt])
  @@map("gacha_types")
}

model GachaHistory {
  id          Int        @id @default(autoincrement())
  userId      String
  gachaTypeId Int
  itemId      Int?
  tierCode    String?
  createdAt   DateTime   @default(now())
  pointsUsed  Int        @default(0)
  gachaType   GachaType? @relation(fields: [gachaTypeId], references: [id])
  item        GachaItem? @relation(fields: [itemId], references: [id])
  tier        PrizeTier? @relation(fields: [tierCode], references: [code])

  @@index([userId, createdAt])
  @@index([gachaTypeId, createdAt])
  @@index([itemId])
  @@index([createdAt])
  @@index([tierCode])
  @@map("gacha_histories")
}

model ItemUsageLog {
  id        Int      @id @default(autoincrement())
  userId    String
  itemId    Int
  usedAt    DateTime @default(now())
  createdAt DateTime @default(now())

  item GachaItem? @relation(fields: [itemId], references: [id])

  @@index([userId, usedAt])
  @@index([itemId])
  @@index([usedAt])
  @@map("item_usage_logs")
}

model UserItem {
  id        Int            @id @default(autoincrement())
  userId    String
  itemId    Int
  status    UserItemStatus @default(UNUSED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  item GachaItem? @relation(fields: [itemId], references: [id])

  @@index([userId, status])
  @@index([userId, itemId])
  @@index([itemId])
  @@map("user_items")
}

model GachaPrizeAssignment {
  id          Int             @id @default(autoincrement())
  gachaTypeId Int
  tierCode    String
  itemId      Int?
  rewardType  PrizeRewardType @default(ITEM)
  points      Int             @default(0)
  weight      Int             @default(1)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  gachaType GachaType  @relation(fields: [gachaTypeId], references: [id])
  tier      PrizeTier  @relation(fields: [tierCode], references: [code])
  item      GachaItem? @relation(fields: [itemId], references: [id])

  @@unique([gachaTypeId, tierCode, itemId])
  @@index([gachaTypeId, tierCode, isActive])
  @@map("gacha_prize_assignments")
}

model Referral {
  id             Int            @id @default(autoincrement())
  userId         String
  referralLinkId String         @unique
  referralLink   String
  status         ReferralStatus @default(PENDING)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@map("referrals")
}

model ReferralHistory {
  id                 Int            @id @default(autoincrement())
  referralId         Int
  referralLinkId     String
  ipAddress          String?
  deviceInfo         String?
  status             ReferralStatus @default(PENDING)
  isFraudDetected    Boolean        @default(false)
  fraudReason        String?
  isBotDetected      Boolean        @default(false)
  botDetectionReason String?
  metadata           String?
  referredAt         DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([referralId, referredAt])
  @@index([referralLinkId])
  @@index([ipAddress, referredAt])
  @@index([status])
  @@index([isBotDetected])
  @@index([isFraudDetected])
  @@map("referral_histories")
}

model ReferralUser {
  id                        Int       @id @default(autoincrement())
  userId                    String
  toUserId                  String
  completedAt               DateTime  @default(now())
  additionalRewardGranted   Boolean   @default(false)
  additionalRewardGrantedAt DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([userId, toUserId], name: "unique_referral_pair")
  @@index([userId, completedAt])
  @@index([toUserId])
  @@index([additionalRewardGranted])
  @@map("referral_users")
}

model UserActivity {
  id         Int      @id @default(autoincrement())
  userId     String   @unique
  gachaCount Int      @default(0)
  totalSpent Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  referralUserId Int? @unique

  @@index([userId])
  @@map("user_activities")
}

model PointHistory {
  id              Int                  @id @default(autoincrement())
  userId          String
  transactionType PointTransactionType
  amount          Int
  balanceBefore   Int                  @default(0)
  balanceAfter    Int
  description     String?
  historyTable    String?
  historyTableId  Int?
  paymentMethod   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([transactionType])
  @@index([historyTable, historyTableId])
  @@map("point_histories")
}

model PointPurchaseLog {
  id                      Int             @id @default(autoincrement())
  userId                  String
  provider                PaymentProvider @default(STRIPE)
  providerPaymentIntentId String          @unique
  amountYen               Int
  planId                  String?
  status                  PaymentStatus   @default(SUCCEEDED)
  errorMessage            String?
  raw                     Json?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([provider, status])
  @@map("point_purchase_logs")
}

model AdminActionHistory {
  id            Int      @id @default(autoincrement())
  actionType    String
  adminUserId   String
  adminName     String
  description   String
  metadata      Json?
  createdAt     DateTime @default(now())
  targetUserIds Json?

  @@index([actionType])
  @@index([adminUserId])
  @@index([createdAt])
  @@map("admin_action_histories")
}

model VideoAsset {
  id          Int      @id @default(autoincrement())
  s3Key       String   @unique
  fileName    String
  fileSize    Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories VideoAssetCategory[]

  @@index([isActive])
  @@map("video_assets")
}

model VideoAssetCategory {
  id        Int               @id @default(autoincrement())
  assetId   Int
  category  VideoCategoryType
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  asset VideoAsset @relation(fields: [assetId], references: [id])

  @@unique([assetId, category])
  @@index([category])
  @@map("video_asset_categories")
}

model PrizeTier {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  label        String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prizeAssignments GachaPrizeAssignment[]
  gachaHistories   GachaHistory[]
  tierWeights      GachaTierWeight[]

  @@index([isActive, displayOrder])
  @@map("prize_tiers")
}

model GachaTierWeight {
  id           Int      @id @default(autoincrement())
  gachaTypeId  Int
  tierCode     String
  weight       Int      @default(0)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gachaType GachaType @relation(fields: [gachaTypeId], references: [id])
  tier      PrizeTier @relation(fields: [tierCode], references: [code])

  @@unique([gachaTypeId, tierCode])
  @@index([gachaTypeId, isActive])
  @@index([gachaTypeId, displayOrder])
  @@map("gacha_tier_weights")
}

model UserPointBalance {
  id         Int      @id @default(autoincrement())
  userId     String   @unique
  paidAmount Int      @default(0)
  freeAmount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("user_point_balances")
}

model PointPurchasePlan {
  id              String   @id
  points          Int
  bonusFreePoints Int      @default(0)
  price           Int
  label           String
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([displayOrder])
  @@map("point_purchase_plans")
}

model Tag {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userTags    UserTag[]

  @@map("tags")
}

model UserTag {
  id        Int      @id @default(autoincrement())
  userId    String
  tagId     Int
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id])

  @@unique([userId, tagId])
  @@index([tagId, userId])
  @@index([userId])
  @@map("user_tags")
}

enum ReferralStatus {
  PENDING
  COMPLETED
  INVALID
  FRAUD
}

enum PointTransactionType {
  PURCHASE
  CONSUME
  GRANT
  REFUND
  REFERRAL_REWARD
}

enum HandRank {
  ROYAL_FLUSH
  STRAIGHT_FLUSH
  FOUR_OF_A_KIND
  FULL_HOUSE
  FLUSH
  STRAIGHT
  THREE_OF_A_KIND
  TWO_PAIR
  ONE_PAIR
  HIGH_CARD
}

enum VideoCategoryType {
  COMMON
  TIER
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  PENDING
}

enum ItemUsageType {
  IMAGE
  SHOW_TO_STAFF
}

enum PointType {
  PAID
  FREE
}

enum UserItemStatus {
  UNUSED
  USED
  EXPIRED
}

enum PrizeRewardType {
  ITEM
  POINTS
}

model DefaultGachaVideoSettings {
  id                  Int      @id @default(autoincrement())
  commonVideoAssetIds Int[]    @default([])
  tierVideoAssetIds   Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("default_gacha_video_settings")
}

model ResultMessageTemplate {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  template    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gachaTypes GachaType[]

  @@index([isActive])
  @@map("result_message_templates")
}

model FreeGachaSettings {
  id                      Int      @id @default(autoincrement())
  isActive                Boolean  @default(true)
  grantOnReferralComplete Boolean  @default(true)
  referrerGachaTypeId     Int?
  refereeGachaTypeId      Int?
  expirationDays          Int?
  referrerPoints          Int      @default(100)
  refereePoints           Int      @default(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  referrerGachaType GachaType? @relation("ReferrerFreeGacha", fields: [referrerGachaTypeId], references: [id])
  refereeGachaType  GachaType? @relation("RefereeFreeGacha", fields: [refereeGachaTypeId], references: [id])

  @@map("free_gacha_settings")
}

model MessageQueue {
  id          Int       @id @default(autoincrement())
  userId      String
  isSent      Boolean   @default(false)
  type        Int       // 1: ガチャ結果
  templateId  Int?
  jsonData    Json
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, isSent, type])
  @@index([userId, createdAt])
  @@index([isSent, type])
  @@map("message_queues")
}
