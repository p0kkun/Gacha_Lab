{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "localstack:up": "docker-compose -f docker-compose.localstack.yml up -d",
    "localstack:down": "docker-compose -f docker-compose.localstack.yml down",
    "localstack:logs": "docker-compose -f docker-compose.localstack.yml logs -f",
    "localstack:setup": "node scripts/setup-localstack.js",
    "mermaid:generate": "mmdc -i docs/gacha-execution-sequence.mmd -o docs/gacha-execution-sequence.png",
    "mermaid:generate:svg": "mmdc -i docs/gacha-execution-sequence.mmd -o docs/gacha-execution-sequence.svg"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@line/bot-sdk": "^10.5.0",
    "@line/liff": "^2.27.3",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.5.3",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "next": "16.0.7",
    "pg": "^8.16.3",
    "prisma": "^7.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.6.0",
    "stripe": "^20.0.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
